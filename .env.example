# ─────────────────────────────────────────────────────────────
#  متغيرات البيئة — انسخ هذا الملف باسم .env ثم املأ القيم
#  (ملف .env مستبعَد من Git ولا يُرفع أبداً)
# ─────────────────────────────────────────────────────────────

# رابط مشروع Supabase — من Project Settings ▸ API ▸ Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# المفتاح العام (anon / publishable). هذا المفتاح مُصمَّم للعمل داخل المتصفح،
# والحماية الحقيقية تأتي من سياسات RLS في قاعدة البيانات.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠ لا تضع مطلقاً service_role key هنا ولا في أي ملف داخل src/
